PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=urbanlink_flow
DB_USER=urbanlink_app
DB_PASSWORD=preencha_a_senha_do_mysql
JWT_SECRET=preencha_uma_chave_aleatoria_longa

# Hospedagem: NODE_ENV=production e HOST=0.0.0.0.
# No Render, PORT é fornecida pelo próprio serviço.
NODE_ENV=development
HOST=127.0.0.1
# Local: permite criar o banco. Hospedado: use false e o banco fornecido pelo provedor.
DB_CREATE_DATABASE=true
# Na hospedagem externa, use true. A validação do certificado permanece ativa.
DB_SSL=false
# Opcional: certificado CA em PEM, com quebras de linha reais ou representadas por \n.
DB_SSL_CA=
# Apenas produção, na primeira inicialização de um banco sem administradores:
INITIAL_ADMIN_NAME=Administrador UrbanLink
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
